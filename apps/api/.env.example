# Copia este archivo a .env y rellena con las credenciales reales.
# Nunca commitees el .env (ya está en .gitignore).

PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Supabase — usa la service_role key (nunca la expongas al frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Integraciones (spec §8) — todas opcionales hasta que se activen ---

# Mail (info/desarrollo/Gmail corporativo + cuentas personales de socios)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (tipo "Web application")
# Scopes necesarios: https://www.googleapis.com/auth/gmail.readonly (o .modify si se quiere marcar como leído)
# Redirect URI a autorizar en Google: {APP_URL_API}/api/integrations/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RRSS — cada una requiere su propia app aprobada por la plataforma
META_APP_ID=
META_APP_SECRET=
# LinkedIn: developer.linkedin.com — crear app y solicitar producto "Marketing Developer Platform"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok for Business API — business.tiktokglobalshop / ads.tiktok.com developer portal
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google Analytics 4 — service account con acceso de lectura a la propiedad GA4
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Banco / Open Banking (PSD2) — proveedor agregador (ej. GoCardless Bank Account Data, Tink, Plaid EU)
OPEN_BANKING_PROVIDER=
OPEN_BANKING_API_KEY=

# Learning / LXP (AWS) — ver docs/spec.md §9, pendiente decidir "directo" vs "réplica"
LXP_CONNECTION_MODE=
LXP_DATABASE_URL=
