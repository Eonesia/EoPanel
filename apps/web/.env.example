# Copia este archivo a .env.local y rellena con las credenciales reales.
# Nunca commitees el .env.local (ya está en .gitignore).

# Supabase — Settings > API en el dashboard del proyecto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL base de la API propia (Express). En desarrollo local suele ser http://localhost:4000
VITE_API_URL=http://localhost:4000
